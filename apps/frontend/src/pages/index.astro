---
import Layout from '../layouts/Layout.astro';
import heroBackground from '../assets/Hero background.jpg';

const heroBackgroundUrl = typeof heroBackground === 'string' ? heroBackground : heroBackground.src;

type CmsMedia = {
	url?: string;
	alt?: string;
};

type RelatedPage = {
	title?: string;
	slug?: string;
	summary?: string;
	featureImage?: CmsMedia | null;
	heroImage?: CmsMedia | null;
};

type FeaturedSection = {
	eyebrow: string;
	title: string;
	slug: string;
	summary: string;
	imageUrl?: string;
	imageAlt?: string;
	imagePlacement: 'left' | 'right';
	imageSize: 'small' | 'medium' | 'large';
	imageWidth: string;
};

type HomeAbout = {
	eyebrow: string;
	title: string;
	description: string;
};

const defaultAbout: HomeAbout = {
	eyebrow: 'About',
	title: 'A practical health knowledge base built one article at a time.',
	description:
		'Meta(bolic)data organizes notes on food, supplements, diets, and studies into decision-ready summaries you can apply in daily life.',
};

const cmsBaseUrls = [import.meta.env.PUBLIC_CMS_URL, 'http://cms:3000', 'http://localhost:3000'].filter(
	Boolean
) as string[];
const publicCmsBaseUrl = ((import.meta as any).env.PUBLIC_CMS_PUBLIC_URL as string | undefined)?.replace(/\/+$/, '') ||
	`${Astro.url.protocol}//${Astro.url.hostname}:3000`;

function getStringValue(value: unknown): string | null {
	if (typeof value !== 'string') return null;
	const trimmed = value.trim();
	return trimmed.length ? trimmed : null;
}

function resolveMediaUrl(url: string): string {
	if (url.startsWith('http://') || url.startsWith('https://')) {
		try {
			const parsed = new URL(url);
			if (parsed.hostname === 'cms') {
				parsed.protocol = Astro.url.protocol;
				parsed.hostname = Astro.url.hostname;
				parsed.port = '3000';
				return parsed.toString();
			}
			return parsed.toString();
		} catch {
			return url;
		}
	}
	return `${publicCmsBaseUrl}${url.startsWith('/') ? '' : '/'}${url}`;
}

function parseMediaAsset(raw: unknown): { imageUrl?: string; imageAlt?: string } {
	if (!raw || typeof raw !== 'object') return {};
	const media = raw as CmsMedia;
	const mediaUrl = getStringValue(media.url);
	if (!mediaUrl) return {};

	return {
		imageUrl: resolveMediaUrl(mediaUrl),
		imageAlt: getStringValue(media.alt) || undefined,
	};
}

function resolveFeaturedMedia(...sources: unknown[]): { imageUrl?: string; imageAlt?: string } {
	for (const source of sources) {
		const media = parseMediaAsset(source);
		if (media.imageUrl) return media;
	}

	return {};
}

function buildFeaturedSection(raw: any): FeaturedSection | null {
	if (!raw || typeof raw !== 'object') return null;

	const article = raw.article && typeof raw.article === 'object' ? (raw.article as RelatedPage) : null;
	const slug = getStringValue(article?.slug);
	const title = getStringValue(article?.title);
	if (!slug || !title) return null;

	const media = resolveFeaturedMedia(raw.imageOverride, article?.featureImage, article?.heroImage);
	const imagePlacement = getStringValue(raw.imagePlacement) === 'left' ? 'left' : 'right';
	const imageSize = ['small', 'medium', 'large'].includes(getStringValue(raw.imageSize) || '')
		? ((getStringValue(raw.imageSize) as 'small' | 'medium' | 'large'))
		: 'medium';
	const imageWidth = ['25', '30', '35', '38', '40', '45', '50', '55', '60'].includes(
		getStringValue(raw.imageWidth) || ''
	)
		? (getStringValue(raw.imageWidth) as string)
		: '38';

	return {
		eyebrow: getStringValue(raw.eyebrow) || 'Featured Article',
		title,
		slug,
		summary:
			getStringValue(raw.summaryOverride) ||
			getStringValue(article?.summary) ||
			'Open this article to read the full breakdown, references, and practical notes.',
		imagePlacement,
		imageSize,
		imageWidth,
		...media,
	};
}

async function fetchHomeData(): Promise<{ about: HomeAbout; featuredSections: FeaturedSection[] }> {
	for (const baseUrl of cmsBaseUrls) {
		try {
			const homeRes = await fetch(`${baseUrl}/api/globals/home-page?depth=2`);
			if (!homeRes.ok) continue;

			const homeData = await homeRes.json();
			const aboutData = homeData?.about;
			const about = {
				eyebrow: getStringValue(aboutData?.eyebrow) || defaultAbout.eyebrow,
				title: getStringValue(aboutData?.title) || defaultAbout.title,
				description: getStringValue(aboutData?.description) || defaultAbout.description,
			};

			const featuredSections = Array.isArray(homeData?.featuredSections)
				? homeData.featuredSections
						.map(buildFeaturedSection)
						.filter((item): item is FeaturedSection => Boolean(item))
				: [];

			return { about, featuredSections };
		} catch (_) {
			// Try next base URL.
		}
	}

	return { about: defaultAbout, featuredSections: [] };
}

const { about, featuredSections } = await fetchHomeData();
---

<Layout title="Metadata" description="Personal health wiki for structured reviews and study notes.">
	<div class="page-shell">
		<main>
			<section class="hero block" style={`--hero-bg: url('${heroBackgroundUrl}')`}>
				<div class="hero-content">
					<p class="eyebrow">By Zack Lown</p>
					<h1>Metadata</h1>
					<p class="lede">
						Meta(bolic)data is a free database about food, diets, and studies related to health and nutrition.
					</p>
				</div>
			</section>

			<section class="block about">
				<p class="eyebrow">{about.eyebrow}</p>
				<h2>{about.title}</h2>
				<p>{about.description}</p>
				<div class="about__actions">
					<a class="about__button" href="/ai-statement">AI statement</a>
					<a class="about__button" href="/site-use">Site use</a>
				</div>
			</section>

			{featuredSections.map((section) => (
				<section
					class={`block subject-card subject-card--${section.imagePlacement} subject-card--${section.imageSize}`}
					style={`--home-image-width: ${section.imageWidth}%;`}
				>
					<div class="subject-card__content">
						<p class="eyebrow">{section.eyebrow}</p>
						<h2>{section.title}</h2>
						<p>{section.summary}</p>
						<a class="read-button" href={`/${encodeURIComponent(section.slug)}`}>Read Article</a>
					</div>
					<div class="subject-card__image">
						{section.imageUrl ? (
							<img
								src={section.imageUrl}
								alt={section.imageAlt || `${section.title} featured image`}
								loading="lazy"
							/>
						) : (
							<div class="subject-card__placeholder">{section.title}</div>
						)}
					</div>
				</section>
			))}
		</main>
	</div>
</Layout>

<style>
	:root {
		--ink: var(--color-text);
		--muted: var(--color-muted);
		--paper: var(--color-bg);
		--card: var(--color-surface);
		--line: var(--color-border);
		--accent: var(--color-accent);
		--accent-hover: var(--color-accent-hover);
	}

	body {
		margin: 0;
		overflow-x: hidden;
		background:
			radial-gradient(circle at 0% 0%, rgba(242, 100, 48, 0.18), transparent 45%),
			radial-gradient(circle at 100% 10%, rgba(31, 138, 112, 0.2), transparent 42%),
			var(--paper);
		color: var(--ink);
	}

	.page-shell {
		width: 100%;
		padding: 0 0 3rem;
	}

	main {
		display: grid;
		gap: 1.2rem;
		padding-inline: 1rem;
	}

	.block {
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--card) 86%, transparent);
		padding: 1.1rem;
	}

	.hero {
		position: relative;
		min-height: clamp(420px, 75vh, 760px);
		display: flex;
		align-items: flex-end;
		padding: clamp(1.2rem, 4vw, 2.4rem);
		width: 100vw;
		max-width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-right: calc(50% - 50vw);
		overflow: hidden;
		border: 0;
		background: transparent;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image:
			linear-gradient(to top, rgba(8, 18, 29, 0.78) 0%, rgba(8, 18, 29, 0.4) 38%, rgba(8, 18, 29, 0.22) 100%),
			var(--hero-bg);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		background-attachment: fixed;
		transform: scale(1.06);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: min(900px, 100%);
	}

	.hero h1 {
		margin: 0;
		font-family: 'Book Antiqua', Palatino, 'Palatino Linotype', serif;
		font-size: clamp(2rem, 5.8vw, 3.6rem);
		line-height: 1.04;
		color: #f7fbff;
	}

	.hero .lede {
		max-width: 56ch;
		margin-top: 0.9rem;
		font-size: 1.05rem;
		color: #e4edf5;
	}

	.eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
	}

	.about h2 {
		margin: 0;
		font-family: 'Book Antiqua', Palatino, 'Palatino Linotype', serif;
		font-size: clamp(1.5rem, 3vw, 2.2rem);
	}

	.about p {
		color: var(--muted);
		line-height: 1.62;
	}

	.about__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 0.5rem;
	}

	.about__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.56rem 0.95rem;
		background: var(--accent);
		color: #ffffff;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 700;
	}

	.about__button:hover {
		background: var(--accent-hover);
	}

	.subject-card {
		display: flex;
		gap: 1rem;
		align-items: stretch;
	}

	.subject-card__content {
		flex: 1 1 0;
		min-width: 0;
	}

	.subject-card--left .subject-card__content {
		order: 2;
	}

	.subject-card--left .subject-card__image {
		order: 1;
	}

	.subject-card--small .subject-card__image {
		min-height: 190px;
	}

	.subject-card--medium .subject-card__image {
		min-height: 230px;
	}

	.subject-card--large .subject-card__image {
		min-height: 290px;
	}

	.subject-card__content h2 {
		margin: 0;
		font-family: 'Book Antiqua', Palatino, 'Palatino Linotype', serif;
		font-size: clamp(1.3rem, 2.5vw, 1.9rem);
	}

	.subject-card__content p {
		margin-top: 0.65rem;
		color: var(--muted);
		line-height: 1.56;
	}

	.read-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 0.6rem;
		padding: 0.56rem 0.95rem;
		background: var(--accent);
		color: #ffffff;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 700;
	}

	.read-button:hover {
		background: var(--accent-hover);
	}

	.subject-card__image {
		flex: 0 0 var(--home-image-width, 38%);
		width: var(--home-image-width, 38%);
		max-width: min(100%, var(--home-image-width, 38%));
		min-width: 180px;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--card) 88%, transparent);
		overflow: hidden;
	}

	.subject-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.subject-card__placeholder {
		height: 100%;
		display: grid;
		place-items: center;
		padding: 1rem;
		text-align: center;
		color: var(--muted);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		background:
			linear-gradient(135deg, rgba(31, 138, 112, 0.12), rgba(242, 100, 48, 0.1)),
			repeating-linear-gradient(
				-45deg,
				rgba(255, 255, 255, 0.55),
				rgba(255, 255, 255, 0.55) 10px,
				rgba(236, 231, 218, 0.45) 10px,
				rgba(236, 231, 218, 0.45) 20px
			);
	}

	@media (max-width: 900px) {
		.subject-card {
			display: grid;
			grid-template-columns: 1fr;
		}

		.subject-card--left .subject-card__content,
		.subject-card--left .subject-card__image {
			order: initial;
		}

		.subject-card__image {
			flex: initial;
			width: 100%;
			max-width: none;
			min-width: 0;
			min-height: 210px;
		}
	}

	@media (max-width: 760px) {
		main {
			padding-inline: 0;
		}

		.hero::before {
			background-attachment: scroll;
		}
	}

	@media (prefers-color-scheme: dark) {
		body {
			background:
				radial-gradient(circle at 0% 0%, rgba(255, 139, 95, 0.12), transparent 45%),
				radial-gradient(circle at 100% 10%, rgba(42, 164, 129, 0.14), transparent 42%),
				var(--paper);
		}

		.subject-card__placeholder {
			background:
				linear-gradient(135deg, rgba(42, 164, 129, 0.12), rgba(255, 139, 95, 0.1)),
				repeating-linear-gradient(
					-45deg,
					rgba(24, 34, 48, 0.7),
					rgba(24, 34, 48, 0.7) 10px,
					rgba(19, 27, 38, 0.82) 10px,
					rgba(19, 27, 38, 0.82) 20px
				);
		}
	}
</style>
