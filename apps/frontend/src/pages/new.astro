---
import Layout from '../layouts/Layout.astro'
export const prerender = false

type CmsPage = {
  title?: string
  slug?: string
  summary?: string
  category?: string
  isNew?: boolean | null
  updatedAt?: string
  createdAt?: string
}

const cmsBaseUrls = [
  import.meta.env.PUBLIC_CMS_URL,
  'http://cms:3000',
  'http://localhost:3000',
].filter(Boolean) as string[]

async function fetchNewArticles(): Promise<CmsPage[]> {
  for (const baseUrl of cmsBaseUrls) {
    try {
      const params = new URLSearchParams({
        limit: '200',
        sort: '-updatedAt',
      })
      const res = await fetch(`${baseUrl}/api/pages?${params.toString()}`)
      if (!res.ok) continue
      const data = await res.json()
      const docs = Array.isArray(data?.docs) ? (data.docs as CmsPage[]) : []
      return docs.filter(
        (doc) =>
          doc?.isNew === true && typeof doc.slug === 'string' && typeof doc.title === 'string',
      )
    } catch (_) {
      // Try next base URL.
    }
  }

  return []
}

const articles = await fetchNewArticles()
---

<Layout title="New Articles | Metadata" description="Recently marked new articles on Metadata.">
  <main class="new-shell">
    <header class="new-header">
      <p class="eyebrow">Fresh Reading</p>
      <h1>New Articles</h1>
      <p>Articles currently marked as new in the CMS.</p>
    </header>

    {
      articles.length === 0 ? (
        <section class="empty-state">
          <h2>No new articles are marked right now.</h2>
          <p>Publish or flag an article as new in the CMS to have it show up here.</p>
        </section>
      ) : (
        <section class="article-grid" aria-label="New articles">
          {articles.map((article) => (
            <article class="article-card">
              <p class="article-card__meta">
                <span>{article.category || 'General'}</span>
                <span>
                  {new Date(
                    article.updatedAt || article.createdAt || Date.now(),
                  ).toLocaleDateString()}
                </span>
              </p>
              <h2>{article.title}</h2>
              <p>{article.summary || 'Open the article to read the full piece.'}</p>
              <a href={`/${encodeURIComponent(article.slug || '')}`}>Read Article</a>
            </article>
          ))}
        </section>
      )
    }
  </main>
</Layout>

<style>
  .new-shell {
    width: min(1100px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .new-header,
  .article-card,
  .empty-state {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1.1rem;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 700;
  }

  .new-header h1,
  .article-card h2,
  .empty-state h2 {
    margin: 0;
    font-family: 'Book Antiqua', Palatino, 'Palatino Linotype', serif;
    color: var(--color-text);
  }

  .new-header p,
  .article-card p,
  .empty-state p {
    color: var(--color-muted);
    line-height: 1.6;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .article-card {
    display: grid;
    gap: 0.75rem;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-card a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .article-card a:hover {
    text-decoration: underline;
  }
</style>
