---
import Layout from '../../layouts/Layout.astro';

const title = 'Privacy Policy | Metadata';
const description = 'Privacy policy for Metadata.';
---

<Layout title={title} description={description}>
	<main class="privacy-page">
		<section class="privacy-shell">
			<h1>Privacy Policy</h1>
			<p class="updated">Effective Date: March 4, 2026</p>

			<p>
				Metadata is committed to protecting your privacy. This page explains how we handle information when you
				use the site.
			</p>

			<h2>1. Information We Collect</h2>
			<p>
				We may collect information you submit directly, such as messages or contact details, and basic usage
				data (for example, analytics and technical logs) needed to keep the site running.
			</p>

			<h2>2. How We Use Information</h2>
			<ul>
				<li>To operate, maintain, and improve the service.</li>
				<li>To troubleshoot issues and protect site security.</li>
				<li>To respond to support requests.</li>
			</ul>

			<h2>3. Cookies</h2>
			<p>
				We may use cookies and similar technologies for analytics and functionality. You can control cookies in your
				browser settings.
			</p>

			<h2>4. Third-Party Services</h2>
			<p>
				We may use third-party services (including hosting and analytics providers) that receive limited data needed
				to provide their services.
			</p>

			<h2>5. Data Retention</h2>
			<p>We retain information only as long as reasonably necessary for operational and legal purposes.</p>

			<h2>6. Your Rights</h2>
			<p>You may request access, correction, or deletion of personal data where applicable under your local laws.</p>

			<h2>7. Contact</h2>
			<p>If you have privacy questions, contact us at <a href="mailto:privacy@metadata.local">privacy@metadata.local</a>.</p>
		</section>
	</main>
</Layout>

<style>
	.privacy-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem 1rem 3rem;
	}

	.privacy-shell {
		border: 1px solid #e3d8c3;
		border-radius: 0.65rem;
		padding: 1.2rem 1.1rem;
		background: #fffdf8;
	}

	.updated {
		color: #6b7280;
		font-size: 0.9rem;
	}

	h1,
	h2 {
		margin-top: 1.15rem;
	}
</style>
