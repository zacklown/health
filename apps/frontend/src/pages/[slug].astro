---
import Layout from '../layouts/Layout.astro'
import {
  renderMarkdown,
  renderMarkdownWithToc,
  slugifyHeading,
  type TocItem,
} from '../lib/articleRendering'
import { getPublicCmsBaseUrl, resolveCmsMediaUrl } from '../lib/cmsMedia'
export const prerender = false

type RelatedArticle = {
  id?: number
  slug?: string
  title?: string
}

type TagItem = {
  tag?: string | null
  name?: string | null
  slug?: string | null
}

type CmsMedia = {
  url?: string | null
  alt?: string | null
}

type StudyRow = {
  citation?: string | null
  studyType?: string | null
  finding?: string | null
  link?: string | null
}

type EvidenceGroup = {
  title?: string | null
  intro?: string | null
  studies?: StudyRow[] | null
}

type ArticleSection = {
  heading?: string | null
  headingLevel?: string | null
  body?: string | null
  image?: CmsMedia | number | null
  imagePlacement?: string | null
  imageSize?: string | null
  imageWidth?: string | null
  imageCaption?: string | null
  evidenceGroups?: EvidenceGroup[] | null
}

type CmsPage = {
  title: string
  slug: string
  category?: string
  summary?: string
  tags?: TagItem[] | null
  showArticleRatings?: boolean | null
  rockRating?: string | null
  scientificEvidence?: string | null
  body?: string
  heroImage?: CmsMedia | number | null
  heroImageCaption?: string | null
  sections?: ArticleSection[] | null
  updatedAt?: string
  createdAt?: string
  relatedArticles?: (RelatedArticle | number)[] | null
}

const cmsBaseUrls = [
  import.meta.env.PUBLIC_CMS_URL,
  'http://cms:3000',
  'http://localhost:3000',
].filter(Boolean) as string[]
const publicCmsBaseUrl = getPublicCmsBaseUrl(Astro.url, {
  PUBLIC_CMS_PUBLIC_URL: (import.meta as any).env.PUBLIC_CMS_PUBLIC_URL as string | undefined,
})

const rockRatingLabels: Record<string, string> = {
  'low-pebble': 'Low Pebble',
  'medium-rock': 'Medium Rock',
  'high-rock': 'High Rock',
  'high-boulder': 'High Boulder',
}

const scientificEvidenceLabels: Record<string, string> = {
  low: 'Low',
  'moderate-low': 'Moderate-Low',
  moderate: 'Moderate',
  'moderate-high': 'Moderate-High',
  high: 'High',
}

function normalizeMediaUrl(url: string): string {
  return resolveCmsMediaUrl(url, publicCmsBaseUrl)
}

function getMediaData(
  media: CmsMedia | number | null | undefined,
): { url: string; alt: string } | null {
  if (!media || typeof media !== 'object') return null
  const url = typeof media.url === 'string' && media.url.trim() ? normalizeMediaUrl(media.url) : ''
  if (!url) return null
  const alt = typeof media.alt === 'string' && media.alt.trim() ? media.alt.trim() : ''
  return { url, alt }
}

function getSelectLabel(
  value: string | null | undefined,
  labels: Record<string, string>,
): string | null {
  if (!value) return null
  return labels[value] || value
}

function normalizeSections(page: CmsPage | null): ArticleSection[] {
  if (!page || !Array.isArray(page.sections)) return []

  return page.sections.filter((section) => {
    if (!section || typeof section !== 'object') return false
    const heading = typeof section.heading === 'string' ? section.heading.trim() : ''
    const body = typeof section.body === 'string' ? section.body.trim() : ''
    const evidenceGroups = Array.isArray(section.evidenceGroups) ? section.evidenceGroups : []
    return Boolean(heading || body || evidenceGroups.length)
  })
}

function buildStructuredToc(sections: ArticleSection[]): TocItem[] {
  const headingCounts = new Map<string, number>()

  return sections.map((section, index) => {
    const text =
      (typeof section.heading === 'string' && section.heading.trim()) || `Section ${index + 1}`
    const headingLevel = section.headingLevel === 'h3' ? 3 : section.headingLevel === 'h4' ? 4 : 2
    const base = slugifyHeading(text) || `section-${index + 1}`
    const count = headingCounts.get(base) ?? 0
    headingCounts.set(base, count + 1)
    const id = count === 0 ? base : `${base}-${count + 1}`
    return { id, text, level: headingLevel }
  })
}

function resolveSectionImageWidth(
  imageWidthValue: string | null | undefined,
  imageSize: string,
): string {
  const numericWidth = Number(imageWidthValue)
  if (Number.isFinite(numericWidth) && numericWidth >= 25 && numericWidth <= 60) {
    return `${numericWidth}%`
  }

  if (imageSize === 'small') return '30%'
  if (imageSize === 'large') return '50%'
  return '38%'
}

function normalizeRelatedArticles(page: CmsPage | null): RelatedArticle[] {
  if (!page || !Array.isArray(page.relatedArticles)) return []
  const seen = new Set<string>()
  const results: RelatedArticle[] = []

  for (const entry of page.relatedArticles) {
    if (!entry || typeof entry !== 'object') continue
    const slug = typeof entry.slug === 'string' ? entry.slug.trim() : ''
    const title = typeof entry.title === 'string' ? entry.title.trim() : ''
    if (!slug || !title) continue
    if (slug === page.slug) continue
    if (seen.has(slug)) continue
    seen.add(slug)
    results.push({ id: entry.id, slug, title })
  }

  return results
}

function normalizeTags(tags: TagItem[] | null | undefined): string[] {
  if (!Array.isArray(tags)) return []

  const seen = new Set<string>()
  const normalized: string[] = []

  for (const entry of tags) {
    const tag =
      typeof entry?.name === 'string' && entry.name.trim()
        ? entry.name.trim()
        : typeof entry?.tag === 'string'
          ? entry.tag.trim()
          : ''
    if (!tag) continue

    const key = tag.toLowerCase()
    if (seen.has(key)) continue
    seen.add(key)
    normalized.push(tag)
  }

  return normalized
}

function splitTags(tags: string[], visibleCount = 3): { visible: string[]; hidden: string[] } {
  return {
    visible: tags.slice(0, visibleCount),
    hidden: tags.slice(visibleCount),
  }
}

async function fetchPageBySlug(slug: string): Promise<CmsPage | null> {
  for (const baseUrl of cmsBaseUrls) {
    try {
      const params = new URLSearchParams({
        depth: '2',
        limit: '1',
        'where[slug][equals]': slug,
      })
      const res = await fetch(`${baseUrl}/api/pages?${params.toString()}`)
      if (!res.ok) continue
      const data = await res.json()
      if (Array.isArray(data?.docs) && data.docs.length > 0) return data.docs[0] as CmsPage
    } catch (_) {
      // Try next base URL.
    }
  }
  return null
}

const slugParam = Astro.params.slug
const page = slugParam ? await fetchPageBySlug(slugParam) : null
const sections = normalizeSections(page)
const structuredToc = buildStructuredToc(sections)
const markdownView = renderMarkdownWithToc(page?.body || '')
const tocItems = structuredToc.length > 0 ? structuredToc : markdownView.toc
const heroImage = getMediaData(page?.heroImage)
const showArticleRatings = page?.showArticleRatings !== false
const rockRatingLabel = showArticleRatings
  ? getSelectLabel(page?.rockRating, rockRatingLabels)
  : null
const scientificEvidenceLabel = showArticleRatings
  ? getSelectLabel(page?.scientificEvidence, scientificEvidenceLabels)
  : null
const relatedArticles = normalizeRelatedArticles(page)
const tags = normalizeTags(page?.tags)
const tagDisplay = splitTags(tags)
const articleTagDialogId = page?.slug ? `article-tags-dialog-${page.slug}` : 'article-tags-dialog'
---

<Layout
  title={`${page?.title || 'Review'} | Health Atlas`}
  description={page?.summary || page?.title || 'Health review page'}
>
  <main class="article-shell">
    <a class="back-link" href="/">&larr; Back to Home</a>
    {
      !page && (
        <article>
          <h1>Article not found</h1>
          <p>That review does not exist yet or was unpublished.</p>
        </article>
      )
    }
    {
      page && (
        <div class="article-layout">
          <aside class="sidebar" aria-label="Article sidebar">
            <section class="toc" aria-label="Table of contents">
              <h2>Table of Contents</h2>
              {tocItems.length > 0 ? (
                <ul>
                  {tocItems.map((item) => (
                    <li class={`toc__level-${item.level}`}>
                      <a class="toc-link" data-target={item.id} href={`#${item.id}`}>
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>No section headers found in this article yet.</p>
              )}
            </section>
            <section class="related" aria-label="Related articles">
              <h2>Related Articles</h2>
              <ul>
                {relatedArticles.map((item) => (
                  <li>
                    <a href={`/${encodeURIComponent(item.slug || '')}`}>{item.title}</a>
                  </li>
                ))}
                <li>
                  <a href="/random-article">Go to random article</a>
                </li>
              </ul>
            </section>
          </aside>
          <article>
            <header class={`article-header${heroImage ? ' article-header--with-hero' : ''}`}>
              <div class="article-header__content">
                <p class="meta">
                  <span>{page.category || 'General'}</span>
                  <span>
                    {new Date(page.updatedAt || page.createdAt || Date.now()).toLocaleDateString()}
                  </span>
                </p>
                <h1>{page.title}</h1>
                {(rockRatingLabel || scientificEvidenceLabel) && (
                  <div class="article-ratings" aria-label="Article ratings">
                    {rockRatingLabel && (
                      <p>
                        <strong>ROCK Rating:</strong> {rockRatingLabel}
                      </p>
                    )}
                    {scientificEvidenceLabel && (
                      <p>
                        <strong>Scientific Evidence:</strong> {scientificEvidenceLabel}
                      </p>
                    )}
                  </div>
                )}
                {tags.length > 0 && (
                  <div class="tag-group">
                    <ul class="article-tags" aria-label="Article tags">
                      {tagDisplay.visible.map((tag) => (
                        <li>{tag}</li>
                      ))}
                      {tagDisplay.hidden.length > 0 && (
                        <li class="article-tags__more">
                          <button
                            type="button"
                            class="tag-more-button"
                            data-tag-dialog-trigger={articleTagDialogId}
                          >
                            More &gt;
                          </button>
                        </li>
                      )}
                    </ul>
                    {tagDisplay.hidden.length > 0 && (
                      <dialog
                        class="tag-dialog"
                        data-tag-dialog={articleTagDialogId}
                        aria-label="Additional article tags"
                      >
                        <div class="tag-dialog__card">
                          <div class="tag-dialog__header">
                            <h2>More Tags</h2>
                            <button
                              type="button"
                              class="tag-dialog__close"
                              data-tag-dialog-close={articleTagDialogId}
                            >
                              Close
                            </button>
                          </div>
                          <ul class="tag-dialog__list">
                            {tagDisplay.hidden.map((tag) => (
                              <li>{tag}</li>
                            ))}
                          </ul>
                        </div>
                      </dialog>
                    )}
                  </div>
                )}
                {page.summary && <p class="article-summary">{page.summary}</p>}
              </div>
              {heroImage && (
                <figure class="hero-figure">
                  <img src={heroImage.url} alt={heroImage.alt || page.title} loading="eager" />
                  {page.heroImageCaption && <figcaption>{page.heroImageCaption}</figcaption>}
                </figure>
              )}
            </header>
            {sections.length > 0 ? (
              <div class="body structured-body">
                {sections.map((section, index) => {
                  const tocItem = structuredToc[index]
                  const sectionImage = getMediaData(section.image)
                  const evidenceGroups = Array.isArray(section.evidenceGroups)
                    ? section.evidenceGroups
                    : []
                  const imagePlacement = section.imagePlacement === 'left' ? 'left' : 'right'
                  const imageSize =
                    section.imageSize === 'small' || section.imageSize === 'large'
                      ? section.imageSize
                      : 'medium'
                  const imageWidth = resolveSectionImageWidth(section.imageWidth, imageSize)

                  return (
                    <section class="article-section" id={tocItem?.id || `section-${index + 1}`}>
                      {section.headingLevel === 'h3' ? (
                        <h3 class="article-section__heading">
                          {section.heading || `Section ${index + 1}`}
                        </h3>
                      ) : section.headingLevel === 'h4' ? (
                        <h4 class="article-section__heading">
                          {section.heading || `Section ${index + 1}`}
                        </h4>
                      ) : (
                        <h2 class="article-section__heading">
                          {section.heading || `Section ${index + 1}`}
                        </h2>
                      )}
                      {(sectionImage || section.body) && (
                        <div class="article-section__layout">
                          {sectionImage && (
                            <figure
                              class={`section-figure section-figure--${imagePlacement} section-figure--${imageSize}`}
                              style={`--section-image-width: ${imageWidth};`}
                            >
                              <img
                                src={sectionImage.url}
                                alt={
                                  sectionImage.alt ||
                                  section.heading ||
                                  `Section ${index + 1} image`
                                }
                                loading="lazy"
                              />
                              {section.imageCaption && (
                                <figcaption>{section.imageCaption}</figcaption>
                              )}
                            </figure>
                          )}
                          {section.body && (
                            <div
                              class="section-copy markdown-body"
                              set:html={renderMarkdown(section.body)}
                            />
                          )}
                        </div>
                      )}
                      {evidenceGroups.length > 0 && (
                        <div class="evidence-groups">
                          {evidenceGroups.map((group) => {
                            const rows = Array.isArray(group.studies)
                              ? group.studies.filter(
                                  (row) =>
                                    row &&
                                    typeof row === 'object' &&
                                    ((typeof row.citation === 'string' && row.citation.trim()) ||
                                      (typeof row.finding === 'string' && row.finding.trim())),
                                )
                              : []

                            if (!rows.length) return null

                            return (
                              <details class="evidence-dropdown">
                                <summary>{group.title || 'Citations and Studies'}</summary>
                                <div class="evidence-dropdown__content">
                                  {group.intro && <p class="evidence-intro">{group.intro}</p>}
                                  <div class="evidence-table-wrap">
                                    <table class="evidence-table">
                                      <thead>
                                        <tr>
                                          <th scope="col">Citation</th>
                                          <th scope="col">Study Type</th>
                                          <th scope="col">Key Finding</th>
                                          <th scope="col">Link</th>
                                        </tr>
                                      </thead>
                                      <tbody>
                                        {rows.map((row) => (
                                          <tr>
                                            <td>{row.citation || '-'}</td>
                                            <td>{row.studyType || '-'}</td>
                                            <td>{row.finding || '-'}</td>
                                            <td>
                                              {row.link ? (
                                                <a href={row.link} target="_blank" rel="noreferrer">
                                                  Open study
                                                </a>
                                              ) : (
                                                '-'
                                              )}
                                            </td>
                                          </tr>
                                        ))}
                                      </tbody>
                                    </table>
                                  </div>
                                </div>
                              </details>
                            )
                          })}
                        </div>
                      )}
                    </section>
                  )
                })}
              </div>
            ) : (
              <div class="body markdown-body" set:html={markdownView.html} />
            )}
          </article>
        </div>
      )
    }
  </main>
</Layout>

<script>
  const headingNodes = Array.from(document.querySelectorAll('article [id]')).filter(
    (node) => node instanceof HTMLElement && /^H[1-3]$/.test(node.tagName),
  )
  const tocLinks = Array.from(document.querySelectorAll('.toc-link'))

  if (headingNodes.length && tocLinks.length) {
    const tocById = new Map(
      tocLinks.map((link) => [decodeURIComponent(link.getAttribute('data-target') || ''), link]),
    )

    const setActiveToc = (id) => {
      tocLinks.forEach((link) => {
        const isActive = link.getAttribute('data-target') === id
        link.classList.toggle('is-active', isActive)
      })
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (!visible.length) return
        const id = visible[0].target.id
        if (tocById.has(id)) setActiveToc(id)
      },
      {
        root: null,
        rootMargin: '-22% 0px -65% 0px',
        threshold: [0, 1],
      },
    )

    headingNodes.forEach((heading) => observer.observe(heading))

    const firstHeadingId = headingNodes[0].id
    if (firstHeadingId) setActiveToc(firstHeadingId)
  }

  const tagDialogTriggers = Array.from(document.querySelectorAll('[data-tag-dialog-trigger]'))

  tagDialogTriggers.forEach((trigger) => {
    if (!(trigger instanceof HTMLButtonElement)) return
    const dialogId = trigger.dataset.tagDialogTrigger
    if (!dialogId) return
    const dialog = document.querySelector(`[data-tag-dialog="${dialogId}"]`)
    if (!(dialog instanceof HTMLDialogElement)) return

    trigger.addEventListener('click', () => {
      dialog.showModal()
    })
  })

  const tagDialogCloseButtons = Array.from(document.querySelectorAll('[data-tag-dialog-close]'))

  tagDialogCloseButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return
    const dialogId = button.dataset.tagDialogClose
    if (!dialogId) return
    const dialog = document.querySelector(`[data-tag-dialog="${dialogId}"]`)
    if (!(dialog instanceof HTMLDialogElement)) return

    button.addEventListener('click', () => {
      dialog.close()
    })
  })

  const tagDialogs = Array.from(document.querySelectorAll('[data-tag-dialog]'))

  tagDialogs.forEach((dialog) => {
    if (!(dialog instanceof HTMLDialogElement)) return

    dialog.addEventListener('click', (event) => {
      const bounds = dialog.getBoundingClientRect()
      const clickedInside =
        event.clientX >= bounds.left &&
        event.clientX <= bounds.right &&
        event.clientY >= bounds.top &&
        event.clientY <= bounds.bottom

      if (!clickedInside) dialog.close()
    })
  })
</script>

<style>
  .article-shell {
    width: min(1300px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .back-link {
    text-decoration: none;
    color: var(--color-accent);
    font-weight: 600;
  }

  .article-layout {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .sidebar {
    position: -webkit-sticky;
    position: sticky;
    top: 6.5rem;
    display: grid;
    gap: 1rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding-right: 0.2rem;
  }

  .toc,
  .related {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.95rem;
  }

  .toc h2,
  .related h2 {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .toc ul,
  .related ul {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.42rem;
  }

  .toc li,
  .related li {
    margin: 0;
  }

  .toc .toc__level-2 {
    padding-left: 0.55rem;
  }

  .toc .toc__level-3 {
    padding-left: 1.1rem;
  }

  .toc a,
  .related a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .toc a:hover,
  .related a:hover {
    color: var(--color-accent);
  }

  .toc a.is-active {
    color: var(--color-accent);
    font-weight: 700;
  }

  .toc p {
    margin: 0.8rem 0 0;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  article {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1.3rem;
  }

  .article-header {
    display: grid;
    gap: 1.2rem;
    align-items: start;
  }

  .article-header--with-hero {
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
  }

  .article-header__content {
    min-width: 0;
  }

  .meta {
    display: flex;
    gap: 0.7rem;
    font-size: 0.8rem;
    color: var(--color-muted);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  h1 {
    font-family: 'Book Antiqua', Palatino, 'Palatino Linotype', serif;
    margin: 0.5rem 0;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: var(--color-text);
  }

  .article-ratings {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin: 0.2rem 0 0.8rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-surface) 94%, white);
  }

  .article-ratings p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .article-summary {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: color-mix(in oklab, var(--color-text) 88%, white);
  }

  .article-tags {
    list-style: none;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.55rem;
    margin: -0.1rem 0 0;
    padding: 0;
    overflow: hidden;
  }

  .article-tags li {
    flex: 0 0 auto;
    margin: 0;
    padding: 0.38rem 0.72rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 28%, var(--color-border));
    background: color-mix(in oklab, var(--color-accent) 10%, var(--color-surface));
    color: color-mix(in oklab, var(--color-text) 88%, var(--color-accent));
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .article-tags__more {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .tag-more-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.16rem 0.1rem;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .tag-more-button:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .tag-dialog {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(34rem, calc(100vw - 2rem));
    width: 100%;
  }

  .tag-dialog::backdrop {
    background: rgba(12, 18, 25, 0.58);
  }

  .tag-dialog__card {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1rem;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.2);
  }

  .tag-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .tag-dialog__header h2 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .tag-dialog__close {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.45rem 0.75rem;
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }

  .tag-dialog__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
  }

  .tag-dialog__list li {
    margin: 0;
    padding: 0.4rem 0.74rem;
