---
import SiteFooter from '../components/SiteFooter.astro';
import SiteNavbar from '../components/SiteNavbar.astro';
import metaDataIconPng from '../assets/MetaDataIcon.png';
import metaDataIconIco from '../assets/MetaDataIcon.ico';

const metaDataIconPngUrl = typeof metaDataIconPng === 'string' ? metaDataIconPng : metaDataIconPng.src;
const metaDataIconIcoUrl = typeof metaDataIconIco === 'string' ? metaDataIconIco : metaDataIconIco.src;

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Health Atlas',
	description = 'A personal encyclopedia for food, supplements, diets, and research notes.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={metaDataIconPngUrl} />
		<link rel="shortcut icon" type="image/x-icon" href={metaDataIconIcoUrl} />
		<link rel="icon" type="image/x-icon" href={metaDataIconIcoUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<SiteNavbar />
		<slot />
		<SiteFooter />
	</body>
</html>

<style>
	:root {
		font-family: 'Avenir Next', Avenir, 'Century Gothic', 'Trebuchet MS', sans-serif;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
</style>
