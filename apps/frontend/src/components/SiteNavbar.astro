---
const navId = 'site-nav';
---

<header class="wf-header">
	<div class="wf-announcement">
		<a href="#">New: Personal health notes now include study snapshots</a>
	</div>
	<div class="wf-nav-shell">
		<a class="wf-brand" href="/" aria-label="MetStat home">MetStat</a>

		<button
			class="wf-menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls={navId}
			aria-label="Toggle navigation"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>

		<nav class="wf-nav" id={navId} aria-label="Primary">
			<ul class="wf-links">
				<li><a href="#">Platform</a></li>
				<li><a href="#">Solutions</a></li>
				<li><a href="#">Resources</a></li>
				<li><a href="#">Enterprise</a></li>
				<li><a href="#">Pricing</a></li>
			</ul>
			<div class="wf-actions">
				<a class="text-link" href="#">Login</a>
				<a class="text-link" href="#">Contact sales</a>
				<a class="cta" href="#">Start for free</a>
			</div>
		</nav>
	</div>
</header>

<script>
	const shell = document.querySelector('.wf-nav-shell');
	const toggle = document.querySelector('.wf-menu-toggle');

	if (shell && toggle) {
		toggle.addEventListener('click', () => {
			const isOpen = shell.classList.toggle('menu-open');
			toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		});

		window.addEventListener('resize', () => {
			if (window.innerWidth > 960 && shell.classList.contains('menu-open')) {
				shell.classList.remove('menu-open');
				toggle.setAttribute('aria-expanded', 'false');
			}
		});
	}
</script>

<style>
	.wf-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: #f7f8fb;
		border-bottom: 1px solid #d6dae2;
	}

	.wf-announcement {
		padding: 0.35rem 1rem;
		text-align: center;
		border-bottom: 1px solid #e2e6ee;
		background: #eef2f8;
		font-size: 0.8rem;
	}

	.wf-announcement a {
		color: #0f172a;
		text-decoration: none;
	}

	.wf-nav-shell {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 1rem;
		width: 100%;
		padding: 0.7rem 1rem;
	}

	.wf-brand {
		text-decoration: none;
		color: #0f172a;
		font-weight: 800;
		font-size: 1.1rem;
		letter-spacing: 0.01em;
	}

	.wf-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.wf-links {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0.2rem;
		margin: 0;
		padding: 0;
	}

	.wf-links a {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.65rem;
		color: #0f172a;
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
	}

	.wf-links a:hover {
		background: #e6ebf3;
	}

	.wf-actions {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}

	.text-link {
		padding: 0.45rem 0.65rem;
		text-decoration: none;
		color: #0f172a;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.text-link:hover {
		background: #e6ebf3;
	}

	.cta {
		padding: 0.5rem 0.75rem;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 700;
		color: #fff;
		background: #2563eb;
		white-space: nowrap;
	}

	.cta:hover {
		background: #1e4ec2;
	}

	.wf-menu-toggle {
		display: none;
		justify-self: end;
		border: 1px solid #d6dae2;
		background: #ffffff;
		padding: 0.4rem 0.45rem;
		cursor: pointer;
	}

	.wf-menu-toggle span {
		display: block;
		width: 1rem;
		height: 2px;
		background: #0f172a;
		margin: 0.16rem 0;
	}

	@media (max-width: 960px) {
		.wf-nav-shell {
			grid-template-columns: auto auto;
		}

		.wf-menu-toggle {
			display: block;
		}

		.wf-nav {
			grid-column: 1 / -1;
			display: grid;
			max-height: 0;
			opacity: 0;
			overflow: hidden;
			pointer-events: none;
			transition: max-height 220ms ease, opacity 220ms ease;
		}

		.wf-nav-shell.menu-open .wf-nav {
			max-height: 85vh;
			opacity: 1;
			pointer-events: auto;
			padding-top: 0.4rem;
		}

		.wf-links,
		.wf-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.wf-links a,
		.text-link,
		.cta {
			width: 100%;
			padding: 0.7rem 0.25rem;
		}
	}
</style>
