---
import metadataLogo from '../assets/MetadataLogo.png';

const metadataLogoUrl = typeof metadataLogo === 'string' ? metadataLogo : metadataLogo.src;

const navId = 'site-nav';

type NavLink = {
	label: string;
	href: string;
};

type NavColumn = {
	title: string;
	links: NavLink[];
};

type NavItem =
	| {
			type: 'link';
			label: string;
			href: string;
			variant?: 'button' | string;
	  }
	| {
			type: 'dropdown';
			label: string;
			href: string;
			columns: NavColumn[];
	  };

function getStringValue(value: unknown): string | null {
	if (value === null || value === undefined) return null;
	if (typeof value === 'string') {
		const trimmed = value.trim();
		return trimmed.length ? trimmed : null;
	}
	if (typeof value === 'number' || typeof value === 'boolean') {
		return String(value);
	}
	return null;
}

function normalizeHref(raw: unknown): string {
	if (typeof raw === 'string') {
		return raw.trim() || '#';
	}

	if (raw && typeof raw === 'object') {
		const linkObject = raw as Record<string, unknown>;
		const directHref = getStringValue(linkObject.href) || getStringValue(linkObject.url) || getStringValue(linkObject.link);
		if (directHref) return directHref;

		if (linkObject.type === 'custom' && getStringValue(linkObject.url)) {
			return getStringValue(linkObject.url) || '#';
		}

		const nestedValue =
			(linkObject as Record<string, unknown>).value ??
			(linkObject as Record<string, unknown>).link ??
			null;
		if (nestedValue) {
			const nested = normalizeHref(nestedValue);
			if (nested) return nested;
		}
	}

	return '#';
}

const defaultAnnouncement = {
	text: 'New: Personal health notes now include study snapshots',
	href: '#',
	enabled: true
};

const defaultNavItems: NavItem[] = [
	{ type: 'link', label: 'Home', href: '/' },
	{
		type: 'dropdown',
		label: 'Nutrition',
		href: '/learn',
		columns: [
			{
				title: 'Foundations',
				links: [
					{ label: 'The Metabolic process', href: '#' },
					{ label: 'Study literacy', href: '#' },
					{ label: 'Measurement methods', href: '#' }
				]
			},
			{
				title: '',
				links: [
					{ label: 'Meal planning', href: '#' },
					{ label: 'Supplement timing', href: '#' },
					{ label: '', href: '#' }
				]
			},
			{
				title: 'Basics',
				links: [
					{ label: 'Nutrition Dictionary', href: '#' },
					{ label: 'Review templates', href: '#' },
					{ label: 'Workflow checklists', href: '#' }
				]
			}
		]
	},
	{
		type: 'dropdown',
		label: 'Activity',
		href: '/blog',
		columns: [
			{
				title: 'Recent',
				links: [
					{ label: 'Food updates', href: '#' },
					{ label: 'Supplement notes', href: '#' },
					{ label: 'Research breakdowns', href: '#' }
				]
			},
			{
				title: 'Categories',
				links: [
					{ label: 'Supplements', href: '#' },
					{ label: 'Diets', href: '#' },
					{ label: 'Metabolism', href: '#' }
				]
			},
			{
				title: 'More',
				links: [
					{ label: 'Case studies', href: '#' },
					{ label: 'Roundups', href: '#' },
					{ label: 'Interviews', href: '#' }
				]
			}
		]
	},
	{ type: 'link', label: 'About', href: '/about' },
	{ type: 'link', label: 'Subscribe', href: '/subscribe', variant: 'button' }
];

const cmsBaseUrls = [import.meta.env.PUBLIC_CMS_URL, 'http://cms:3000', 'http://localhost:3000'].filter(
	Boolean
) as string[];

function normalizeAnnouncement(raw: any) {
	if (!raw || typeof raw !== 'object') return null;
	const enabled = raw.enabled !== false;
	const text = raw.text || raw.label || raw.message;
	const href = normalizeHref(raw.href ?? raw.url ?? raw.link);
	if (!text || typeof text !== 'string') return null;
	return { enabled, text: String(text), href: href ? String(href) : '#' };
}

function normalizeLinks(rawLinks: any): NavLink[] {
	if (!Array.isArray(rawLinks)) return [];
	return rawLinks
		.map((item) => {
			if (!item || typeof item !== 'object') return null;
			const label = (item.label || item.title || item.text || '').toString().trim();
			const href = normalizeHref(item.href ?? item.url ?? item.link);
			if (!label || !href) return null;
			return { label, href };
		})
		.filter((item): item is NavLink => Boolean(item));
}

function normalizeColumns(rawColumns: any): NavColumn[] {
	if (!Array.isArray(rawColumns)) return [];
	return rawColumns
		.map((item) => {
			if (!item || typeof item !== 'object') return null;
			const title = (item.title || '').toString();
			const links = normalizeLinks(item.links || item.items || item.children);
			if (!links.length) return null;
			return { title, links };
		})
		.filter((item): item is NavColumn => Boolean(item));
}

function normalizeNavItem(raw: any): NavItem | null {
	if (!raw || typeof raw !== 'object') return null;
	const label = (raw.label || raw.title || '').toString().trim();
	const href = normalizeHref(raw.href ?? raw.url ?? raw.link);
	if (!label) return null;

	const itemType = (raw.type || raw.kind || '').toString().toLowerCase();
	const rawColumns = Array.isArray(raw.columns) ? raw.columns : [];
	const hasColumns =
		rawColumns.length > 0 &&
		rawColumns.some(
			(col: any) =>
				col &&
				typeof col === 'object' &&
				(Array.isArray(col.links) || Array.isArray(col.items) || Array.isArray(col.children)) &&
				(col.links?.length || col.items?.length || col.children?.length)
		);
	const isDropdown =
		itemType === 'dropdown' ||
		itemType === 'menu' ||
		hasColumns ||
		Array.isArray(raw.linkGroups) ||
		Array.isArray(raw.groups);
	const variant = raw.variant || raw.style || raw.variantClass;

	if (isDropdown) {
		const columns = normalizeColumns(rawColumns || raw.linkGroups || raw.groups || raw.items);
		if (!columns.length) return null;
		return {
			type: 'dropdown',
			label,
			href,
			columns
		};
	}

	return {
		type: 'link',
		label,
		href,
		variant: variant ? String(variant) : undefined
	};
}

function normalizeNavItems(rawItems: any): NavItem[] {
	if (!Array.isArray(rawItems)) return [];
	return rawItems
		.map(normalizeNavItem)
		.filter((item): item is NavItem => Boolean(item))
		.filter((item) => item.label && item.href);
}

function parseCmsNavPayload(payload: any): { announcement: typeof defaultAnnouncement; items: NavItem[] } | null {
	if (!payload || typeof payload !== 'object') return null;
	const doc = payload.doc || payload.data?.[0] || payload.docs?.[0] || payload.data || payload;
	if (!doc || typeof doc !== 'object') return null;

	const announcement = normalizeAnnouncement(doc.announcement || doc.topAnnouncement || doc.banner);
	const items = normalizeNavItems(
		doc.navItems || doc.navigation || doc.nav || doc.items || doc.links || doc.defaultLinks
	);
	if (!announcement && !items.length) return null;

	return {
		announcement: announcement || defaultAnnouncement,
		items: items.length ? items : defaultNavItems
	};
}

function getDropdownPanelStyle(item: NavItem & { columns: NavColumn[] }) {
	const columns = Math.max(item.columns.length, 1);
	const maxItemsInColumn = item.columns.reduce((count, column) => Math.max(count, column.links.length), 0);
	const totalItems = item.columns.reduce((count, column) => count + column.links.length, 0);
	const width = Math.max(columns * 210, 220 + maxItemsInColumn * 18, 180 + totalItems * 7);

	return {
		style: `--meta-columns: ${columns}; --meta-width: ${Math.min(width, 1200)}px;`
	};
}

async function loadNavConfig() {
	const endpoints = [
		'/api/site-navigation?depth=2',
		'/api/site-settings?depth=2',
		'/api/globals/site-navigation?depth=2',
		'/api/globals/site-settings?depth=2',
		'/api/pages?limit=1&where[slug][equals]=site-navigation',
		'/api/pages?limit=1&where[slug][equals]=site-config'
	];

	for (const baseUrl of cmsBaseUrls) {
		for (const endpoint of endpoints) {
			try {
				const res = await fetch(`${baseUrl}${endpoint}`);
				if (!res.ok) continue;
				const data = await res.json();
				const parsed = parseCmsNavPayload(data);
				if (parsed) return parsed;
			} catch (_) {
				// continue to next endpoint/base.
			}
		}
	}

	return { announcement: defaultAnnouncement, items: defaultNavItems };
}

const cmsNavConfig = await loadNavConfig();
const announcement = cmsNavConfig.announcement;
const navItems = cmsNavConfig.items;
---

<header class="meta-header">
	{announcement.enabled === false ? null : (
		<div class="meta-announcement">
			<a href={announcement.href}>{announcement.text}</a>
		</div>
	)}
	<div class="meta-nav-shell">
	<a class="meta-brand" href="/" aria-label="Metadata home">
			<img class="meta-logo" src={metadataLogoUrl} alt="Metadata logo" />
	</a>

		<button
			class="meta-menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls={navId}
			aria-label="Toggle navigation"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>

		<nav class="meta-nav" id={navId} aria-label="Primary">
			<ul class="meta-links">
				{navItems.map((item) => (
					<li>
						{item.type === 'dropdown' ? (
							<div class="meta-dropdown">
								<a
									href={item.href}
									class="meta-dropdown-trigger"
									aria-haspopup="true"
									aria-expanded="false"
								>
									{item.label}
								</a>
								<div
									class="meta-dropdown-panel"
									role="menu"
									style={getDropdownPanelStyle(item).style}
									aria-label={`${item.label} links`}
								>
									{item.columns.map((column) => (
										<div class="meta-dropdown-col">
											{column.title ? <p>{column.title}</p> : null}
											<ul>
												{column.links.map((linkItem) => (
													<li><a href={linkItem.href}>{linkItem.label}</a></li>
												))}
											</ul>
										</div>
									))}
								</div>
							</div>
						) : (
							<a href={item.href} class={item.variant === 'button' ? 'meta-subscribe' : ''}>
								{item.label}
							</a>
						)}
					</li>
				))}
			</ul>
			<form class="meta-search" role="search" action="/review" method="get">
				<label for="site-search" class="meta-sr-only">Search</label>
				<input id="site-search" name="q" type="search" placeholder="Search topics..." />
				<button type="submit" aria-label="Search">Search</button>
			</form>
		</nav>
	</div>
</header>

<script>
	const shell = document.querySelector('.meta-nav-shell');
	const toggle = document.querySelector('.meta-menu-toggle');
	const dropdownLinks = document.querySelectorAll('.meta-dropdown-trigger');
	const dropdowns = document.querySelectorAll('.meta-dropdown');
	const isTouchDevice =
		window.matchMedia('(hover: none), (pointer: coarse)').matches || 'ontouchstart' in window;

	if (shell && toggle) {
		toggle.addEventListener('click', () => {
			const isOpen = shell.classList.toggle('menu-open');
			toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		});

		window.addEventListener('resize', () => {
			if (window.innerWidth > 960 && shell.classList.contains('menu-open')) {
				shell.classList.remove('menu-open');
				toggle.setAttribute('aria-expanded', 'false');
			}
		});
	}

	if (isTouchDevice && dropdownLinks.length && dropdowns.length) {
		const closeAll = () => {
			dropdowns.forEach((dropdown) => {
				dropdown.classList.remove('is-open');
			});
			dropdownLinks.forEach((link) => {
				link.setAttribute('aria-expanded', 'false');
			});
		};

		dropdownLinks.forEach((link) => {
			link.addEventListener('click', (event) => {
				const dropdown = link.closest('.meta-dropdown');
				if (!dropdown) return;
				if (dropdown.classList.contains('is-open')) return;

				event.preventDefault();
				closeAll();
				dropdown.classList.add('is-open');
				link.setAttribute('aria-expanded', 'true');
			});
		});

		document.addEventListener('click', (event) => {
			if (event.target instanceof Element && event.target.closest('.meta-dropdown')) return;
			closeAll();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeAll();
		});
	}
</script>

<style>
	.meta-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: #f7f8fb;
		border-bottom: 1px solid #d6dae2;
	}

	.meta-announcement {
		padding: 0.35rem 1rem;
		text-align: center;
		border-bottom: 1px solid #e2e6ee;
		background: #eef2f8;
		font-size: 0.8rem;
	}

	.meta-announcement a {
		color: #0f172a;
		text-decoration: none;
	}

	.meta-nav-shell {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		width: 100%;
		padding: 0.7rem 1rem;
		column-gap: 1rem;
	}

	.meta-logo {
		width: 132px;
		height: 32px;
		display: block;
	}

	.meta-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: #0f172a;
		text-decoration: none;
		font-weight: 800;
		font-size: 1.1rem;
		letter-spacing: 0.01em;
	}

	.meta-brand-text {
		display: inline-block;
		font-size: 0.98rem;
		font-weight: 700;
	}

	.meta-brand:hover span {
		opacity: 0.85;
	}

	.meta-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		width: 100%;
	}

	.meta-links {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 auto;
		padding: 0;
	}

	.meta-links > li {
		position: relative;
	}

	.meta-links a,
	.meta-dropdown > a {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.65rem;
		color: #0f172a;
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.meta-dropdown > a::after {
		content: '▾';
		font-size: 0.76rem;
		margin-left: 0.28rem;
		color: #68768b;
	}

	.meta-dropdown-panel {
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		display: grid;
		grid-template-columns: repeat(var(--meta-columns, 3), minmax(150px, 1fr));
		gap: 0.85rem;
		width: min(var(--meta-width, 620px), 88vw);
		padding: 0.95rem;
		border: 1px solid var(--line, #d6dae2);
		background: #fff;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 160ms ease,
			transform 160ms ease,
			visibility 160ms ease;
		box-shadow: 0 14px 28px rgba(2, 17, 36, 0.14);
	}

	.meta-dropdown:hover .meta-dropdown-panel,
	.meta-dropdown:focus-within .meta-dropdown-panel,
	.meta-dropdown.is-open .meta-dropdown-panel {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateX(-50%);
	}

	.meta-dropdown-col p {
		margin: 0 0 0.45rem;
		font-size: 0.73rem;
		font-weight: 700;
		color: #4d5970;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.meta-dropdown-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.3rem;
	}

	.meta-dropdown-col a {
		display: block;
		padding: 0.3rem 0.1rem;
		font-size: 0.87rem;
		font-weight: 500;
		color: #1e293b;
	}

	.meta-links a:hover,
	.meta-dropdown-col a:hover {
		background: #e6ebf3;
	}

	.meta-subscribe:hover {
		background: #e6ebf3;
	}

	.meta-subscribe {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.48rem 0.9rem;
		background: #f26430;
		color: #fff;
		font-size: 0.92rem;
		font-weight: 500;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		background: #1f8a70;
	}

	.meta-subscribe:hover {
		background: #176e5a;
	}

	.meta-search {
		margin-left: 0;
		display: flex;
		align-items: stretch;
		gap: 0.45rem;
	}

	.meta-search input {
		min-width: 170px;
		width: 15rem;
		max-width: 22vw;
		padding: 0.43rem 0.6rem;
		border: 1px solid #c8cfdd;
		border-radius: 0.45rem;
		background: #fff;
		color: #0f172a;
		font-size: 0.9rem;
	}

	.meta-search input:focus {
		outline: 2px solid #1f8a70;
		outline-offset: 1px;
	}

	.meta-search button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.43rem 0.75rem;
		border: 1px solid #1f8a70;
		background: #1f8a70;
		color: #fff;
		font-size: 0.86rem;
		font-weight: 700;
		cursor: pointer;
		border-radius: 0.45rem;
	}

	.meta-search button:hover {
		background: #176e5a;
		border-color: #176e5a;
	}

	.meta-sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.meta-menu-toggle {
		display: none;
		border: 1px solid #d6dae2;
		background: #ffffff;
		padding: 0.4rem 0.45rem;
		cursor: pointer;
	}

	.meta-menu-toggle span {
		display: block;
		width: 1rem;
		height: 2px;
		background: #0f172a;
		margin: 0.16rem 0;
	}

	@media (max-width: 960px) {
		.meta-nav-shell {
			grid-template-columns: auto auto;
		}

		.meta-brand span {
			display: inline;
			font-size: 1rem;
			letter-spacing: 0.01em;
		}

		.meta-menu-toggle {
			display: block;
			justify-self: end;
		}

		.meta-nav {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: 1fr;
			justify-content: stretch;
			max-height: 0;
			opacity: 0;
			overflow: hidden;
			pointer-events: none;
			transition: max-height 220ms ease, opacity 220ms ease;
			place-items: stretch;
		}

		.meta-nav-shell.menu-open .meta-nav {
			max-height: 85vh;
			opacity: 1;
			pointer-events: auto;
			padding-top: 0.4rem;
		}

		.meta-links,
		.meta-search {
			flex-direction: column;
			margin: 0;
		}

		.meta-links {
			flex-direction: column;
		}

		.meta-links,
		.meta-search {
			align-items: stretch;
		}

		.meta-links a,
		.meta-subscribe,
		.meta-search input,
		.meta-search button {
			width: 100%;
			padding: 0.7rem 0.25rem;
		}

		.meta-search {
			max-width: 100%;
			width: 100%;
			flex-direction: row;
			align-items: stretch;
			gap: 0.45rem;
		}

		.meta-search button,
		.meta-search input {
			max-width: none;
		}

		.meta-dropdown-panel {
			position: static;
			left: auto;
			transform: none;
			width: 100%;
			border: none;
			box-shadow: none;
			opacity: 0;
			visibility: hidden;
			pointer-events: auto;
			grid-template-columns: 1fr;
			padding: 0;
			max-height: 0;
			overflow: hidden;
			transition:
				opacity 220ms ease,
				visibility 220ms ease,
				max-height 220ms ease;
		}

		.meta-dropdown.is-open .meta-dropdown-panel {
			opacity: 1;
			visibility: visible;
			max-height: 1200px;
			padding: 0.45rem 0.2rem 0;
		}

		.meta-dropdown > a::after {
			content: '';
		}

		.meta-dropdown-col p {
			font-size: 0.67rem;
			margin: 0.55rem 0 0.3rem;
		}
	}
</style>

